# Application
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1
PUBLIC_APP_ORIGIN=http://localhost:4200
ALLOWED_ORIGINS=http://localhost:4200

# Database (MongoDB Atlas)
MONGODB_URI=
MONGODB_DB_NAME=al_azhari_library

# Authentication & JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d
JWT_ISSUER=al-azhari-library
JWT_AUDIENCE=al-azhari-web

# Refresh Cookie Configuration
REFRESH_COOKIE_NAME=al_azhari_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax

# Argon2 Password Hashing
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PAYMENT_PROOF_FOLDER=al-azhari/payment-proofs
CLOUDINARY_PRODUCT_FOLDER=al-azhari/products

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
WHATSAPP_PHONE=

# Realtime / Socket.IO
SOCKET_PATH=/socket.io

# Reverse Proxy & Rate Limiting
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=20

# Background Outbox Worker
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=5
